# Скопируйте этот файл в .env и впишите свои значения.
# На хостинге (например, Render) эти же переменные вводятся
# не файлом, а через раздел "Environment" в настройках сервиса.

# --- Планфикс ---
PLANFIX_ACCOUNT=mycompany
PLANFIX_TOKEN=вставьте_сюда_токен_из_планфикс
PLANFIX_AMO_FIELD_ID=123
PLANFIX_PROJECT_ID=

# --- amoMessenger ---
AMO_ACCESS_TOKEN=вставьте_сюда_токен_приложения
AMO_API_BASE_URL=https://api.amo.io/v1.3

# --- Общая защита вебхуков ---
WEBHOOK_SECRET=придумайте-длинную-случайную-строку

PORT=3000
